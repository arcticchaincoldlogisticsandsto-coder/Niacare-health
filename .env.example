# Client-exposed (Vite only bundles VITE_-prefixed vars into the browser build).
# From your Supabase project: Settings -> API. Required — the app throws on
# startup without these.
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-public-key"

# Optional client branding / feature flags.
VITE_APP_NAME="NiaCare Health"
VITE_DEFAULT_COUNTRY="TZ"
VITE_ENABLE_DEMO_HELPERS="false"

# Optional — URL to a prepared anatomical GLB (see docs/body-map-assets.md
# and src/components/body-map/anatomicalModel.ts). Left unset, the Body
# Map keeps using its current procedural mannequin; this is not wired
# into the UI yet, so setting it currently has no effect.
VITE_ANATOMICAL_MODEL_URL=""

# Server-only — used exclusively by api/triage.ts (a Vercel Serverless
# Function). Never reference this from src/ — it must never reach the
# browser bundle. Get a key at console.groq.com.
GROQ_API_KEY="your-groq-api-key"

# Server-only — used exclusively by api/video-room.ts (a Vercel Serverless
# Function) to create real telehealth video rooms via Daily.co. Never
# reference this from src/. Get a key at your Daily dashboard ->
# Developers -> API Keys (dashboard.daily.co).
DAILY_API_KEY="your-daily-api-key"

# Server-only — used by api/invite-staff.ts to create role-preset accounts.
# This is a Supabase service-role key; never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
SUPABASE_URL="https://your-project-ref.supabase.co"

