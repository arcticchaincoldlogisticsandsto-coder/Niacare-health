# Client-exposed (Vite only bundles VITE_-prefixed vars into the browser build).
# From your Supabase project: Settings -> API. Required — the app throws on
# startup without these.
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-public-key"

# Server-only — used exclusively by api/triage.ts (a Vercel Serverless
# Function). Never reference this from src/ — it must never reach the
# browser bundle. Get a key at console.groq.com.
GROQ_API_KEY="your-groq-api-key"

# Server-only — used exclusively by api/video-room.ts (a Vercel Serverless
# Function) to create real telehealth video rooms via Daily.co. Never
# reference this from src/. Get a key at your Daily dashboard ->
# Developers -> API Keys (dashboard.daily.co).
DAILY_API_KEY="your-daily-api-key"

